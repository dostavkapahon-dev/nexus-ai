# --- AI-провайдеры (можно задать любой один — остальные подхватятся из UII) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
# OpenRouter — один ключ = сотни моделей (модель в формате vendor/model)
OPENROUTER_API_KEY=sk-or-v1-...
XAI_API_KEY=xai-...
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=pplx-...
# Свой OpenAI-совместимый endpoint (Ollama / vLLM / LM Studio / шлюз)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=

# --- Telegram-бот ---
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-100...

# --- Публикация ---
INSTAGRAM_ACCESS_TOKEN=EAA...
INSTAGRAM_ACCOUNT_ID=17841400...
VK_ACCESS_TOKEN=vk1.a...
VK_GROUP_ID=123456789
YOUTUBE_API_KEY=AIza...

# --- Генерация видео ---
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
# HIXIIT (Higgsfield) — ОСНОВНОЙ путь через MCP-подключение аккаунта
HIGGSFIELD_MCP_URL=
HIGGSFIELD_MCP_TOKEN=
# Запасные пути (используются, если MCP недоступен)
HIGGSFIELD_API_KEY=
HIGGSFIELD_SECRET=
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=

# --- Браузерный агент (desktop_agent.py подключается к серверу) ---
NEXUS_TOKEN=

# --- Память ---
# Postgres = постоянная память. Без него SQLite-файл на Render стирается при рестарте.
DATABASE_URL=
NEXUS_DB_PATH=./nexus.db

# --- Pakhon Studio ---
NEXUS_TZ=Asia/Almaty
AUTO_PUBLISH=0   # 1 = автопубликация дневной фабрики, 0 = только превью в Telegram
IMAGEN_MODEL=imagen-3.0-generate-002
HIGGSFIELD_MODEL=higgsfield-dop
