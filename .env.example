ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
# NVIDIA NIM — бесплатные кредиты на открытые модели (build.nvidia.com/settings/api-keys)
NVIDIA_API_KEY=nvapi-...
# Прочие бесплатные (любой из них включает исполнителя без оплаты)
GROQ_API_KEY=gsk_...                 # console.groq.com/keys — самая быстрая выдача
CEREBRAS_API_KEY=csk-...             # cloud.cerebras.ai — ~1 млн токенов/сутки
OPENROUTER_API_KEY=sk-or-v1-...      # openrouter.ai/keys — только модели :free
MISTRAL_API_KEY=                     # console.mistral.ai/api-keys
GITHUB_MODELS_TOKEN=ghp_...          # github.com/settings/tokens, права models:read
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-100...

# --- Публикация (бесплатно, официальные API площадок; браузер-агент как fallback) ---
INSTAGRAM_ACCESS_TOKEN=EAA...      # заполняется автоматически при OAuth-подключении
INSTAGRAM_ACCOUNT_ID=17841400...   # тоже определяется автоматически
# Своё приложение Meta — нужно для OAuth и продления токена (иначе токен умрёт через 60 дней)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Публичный адрес сервиса для redirect_uri (на Render подставляется сам)
NEXUS_PUBLIC_URL=
TIKTOK_ACCESS_TOKEN=              # TikTok for Developers → Content Posting API
THREADS_ACCESS_TOKEN=            # Threads Graph API
THREADS_USER_ID=
VK_ACCESS_TOKEN=vk1.a...
VK_GROUP_ID=123456789
YOUTUBE_API_KEY=AIza...           # только для поиска трендов
YOUTUBE_OAUTH_JSON=              # OAuth JSON для загрузки Shorts (иначе — браузер-fallback)

# --- Анализ аккаунтов (бесплатно, без сторонних платных сервисов) ---
# Ники, которые бот анализирует (свои или конкурентов) — YouTube/TikTok через yt-dlp даром.
IG_HANDLE=
TIKTOK_HANDLE=
YOUTUBE_HANDLE=
# Instagram обычно требует обхода логина — опционально через Bright Data Web Unlocker.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=web_unlocker1
# Режим анализа: auto = сервисы (API/Bright Data/yt-dlp), при неудаче браузер;
# browser = всё через браузер БЕЗ API; api = только сервисы, без браузера.
NEXUS_ANALYZE_MODE=auto

# --- Генерация видео ---
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
# HIXIIT (Higgsfield) — для сервера правильный путь это ключ+секрет
# из https://cloud.higgsfield.ai (заголовок «Authorization: Key ключ:секрет»).
HIGGSFIELD_API_KEY=
HIGGSFIELD_SECRET=
# MCP-подключение (mcp.higgsfield.ai/mcp) работает по OAuth-токену, который
# со временем истекает, — для неприсмотренного сервера это запасной путь.
HIGGSFIELD_MCP_URL=
HIGGSFIELD_MCP_TOKEN=
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=

# --- Браузерный агент (desktop_agent.py подключается к серверу) ---
NEXUS_TOKEN=

# --- Публикация без API (через браузер) ---
# auto = API если есть токен, иначе браузер; browser = всё через браузер без API; api = только API.
NEXUS_PUBLISH_MODE=auto
# Серверный браузер — «руки» без ПК пользователя. 1=вкл, 0=выкл.
NEXUS_SERVER_BROWSER=1
# УДАЛЁННЫЙ облачный браузер (рекомендуется для Render 512 МБ — не грузит инстанс).
# Эндпоинт CDP, напр. Bright Data Scraping Browser: wss://brd-customer-...:PASS@brd.superproxy.io:9222
NEXUS_BROWSER_CDP=
# Если NEXUS_BROWSER_CDP пуст — браузер поднимается ЛОКАЛЬНО на сервере (нужен VPS с памятью):
NEXUS_BROWSER_HEADLESS=1
NEXUS_BROWSER_PROFILE=
# Опц.: вход в аккаунты — storage_state JSON от Playwright (путь к файлу или сам JSON).
NEXUS_BROWSER_STORAGE_STATE=

# --- Pakhon Studio ---
NEXUS_TZ=Asia/Almaty
AUTO_PUBLISH=0   # 1 = автопубликация дневной фабрики, 0 = только превью в Telegram
IMAGEN_MODEL=imagen-3.0-generate-002
HIGGSFIELD_MODEL=higgsfield-dop
